# PPAP Project Environment Variables
# 
# Copy this file to .env and fill in your values.
# Never commit actual secrets to version control.

# API Configuration
VITE_API_BASE_URL=/api

# Application Settings
VITE_APP_NAME=PPAP Project
VITE_APP_DESCRIPTION=PPAP Forms Management for Automotive Glass

# Feature Flags
VITE_FEATURE_UPLOAD=true
VITE_FEATURE_PDF_EXPORT=true
VITE_FEATURE_ELEMENT_TABLES=true